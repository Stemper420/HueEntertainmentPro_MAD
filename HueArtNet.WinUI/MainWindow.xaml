<Window
    x:Class="HueArtNet.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Hue Art-Net Controller">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="180" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="4">
                <TextBlock Text="Hue Art-Net Controller" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="Receive Art-Net DMX and drive up to 4 Philips Hue Entertainment hubs" Opacity="0.72" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                <Button Content="New template" Click="NewTemplate_Click" />
                <Button Content="Reload" Click="Reload_Click" />
                <Button Content="Save profile" Click="SaveProfile_Click" />
                <Button Content="Start profile" Click="StartProfile_Click" />
                <Button Content="Stop" Click="StopProfile_Click" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="18">
                <Grid ColumnSpacing="12" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Column="0" Text="Discovered bridge" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="Apply to hub row" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="Entertainment group" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="3" Text="Light order" FontWeight="SemiBold" />

                    <ComboBox x:Name="DiscoveredBridgeComboBox" Grid.Row="1" Grid.Column="0" />
                    <ComboBox x:Name="PairingHubRowComboBox" Grid.Row="1" Grid.Column="1" SelectedIndex="0">
                        <ComboBoxItem Content="Hub 1" Tag="0" />
                        <ComboBoxItem Content="Hub 2" Tag="1" />
                        <ComboBoxItem Content="Hub 3" Tag="2" />
                        <ComboBoxItem Content="Hub 4" Tag="3" />
                    </ComboBox>
                    <ComboBox x:Name="EntertainmentGroupComboBox" Grid.Row="1" Grid.Column="2" SelectionChanged="EntertainmentGroupComboBox_SelectionChanged" />
                    <TextBox x:Name="PairedLightOrderTextBox" Grid.Row="1" Grid.Column="3" IsReadOnly="True" />
                    <Button Grid.Row="1" Grid.Column="4" Content="Discover bridges" Click="DiscoverBridges_Click" />
                    <Button x:Name="PairSelectedBridgeButton" Grid.Row="1" Grid.Column="5" Content="Pair selected" Click="PairSelectedBridge_Click" />
                </Grid>

                <Grid ColumnSpacing="12" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Column="0" Text="Profile name" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="Bind IPv4" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="UDP port" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="3" Text="FPS" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="4" Text="Timeout" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="5" Text="Seconds" FontWeight="SemiBold" />

                    <TextBox x:Name="ProfileNameTextBox" Grid.Row="1" Grid.Column="0" PlaceholderText="Main room" />
                    <TextBox x:Name="BindAddressTextBox" Grid.Row="1" Grid.Column="1" PlaceholderText="0.0.0.0" />
                    <TextBox x:Name="ArtNetPortTextBox" Grid.Row="1" Grid.Column="2" Text="6454" />
                    <TextBox x:Name="OutputFpsTextBox" Grid.Row="1" Grid.Column="3" Text="20" />
                    <ComboBox x:Name="TimeoutModeComboBox" Grid.Row="1" Grid.Column="4" SelectedIndex="0">
                        <ComboBoxItem Content="Hold last frame" Tag="HoldLastFrame" />
                        <ComboBoxItem Content="Blackout" Tag="Blackout" />
                        <ComboBoxItem Content="Restore startup" Tag="RestoreStartupState" />
                    </ComboBox>
                    <TextBox x:Name="TimeoutSecondsTextBox" Grid.Row="1" Grid.Column="5" Text="2" />
                </Grid>

                <Grid ColumnSpacing="8" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="180" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Column="0" Text="Enabled" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="Hub name" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="Bridge IP" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="3" Text="Application key" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="4" Text="Entertainment key" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="5" Text="Entertainment group ID" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="6" Text="Universe" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="7" Text="Start" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="8" Text="Mode" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="9" Text="Light order" FontWeight="SemiBold" />

                    <CheckBox x:Name="Hub1EnabledCheckBox" Grid.Row="1" Grid.Column="0" IsChecked="True" />
                    <TextBox x:Name="Hub1NameTextBox" Grid.Row="1" Grid.Column="1" />
                    <TextBox x:Name="Hub1BridgeIpTextBox" Grid.Row="1" Grid.Column="2" />
                    <PasswordBox x:Name="Hub1ApplicationKeyBox" Grid.Row="1" Grid.Column="3" />
                    <PasswordBox x:Name="Hub1EntertainmentKeyBox" Grid.Row="1" Grid.Column="4" />
                    <TextBox x:Name="Hub1EntertainmentGroupIdTextBox" Grid.Row="1" Grid.Column="5" />
                    <TextBox x:Name="Hub1UniverseTextBox" Grid.Row="1" Grid.Column="6" />
                    <TextBox x:Name="Hub1StartChannelTextBox" Grid.Row="1" Grid.Column="7" />
                    <ComboBox x:Name="Hub1FixtureModeComboBox" Grid.Row="1" Grid.Column="8">
                        <ComboBoxItem Content="RGB 3ch" Tag="Rgb3" />
                        <ComboBoxItem Content="RGBWW 5ch" Tag="Rgbww5" />
                        <ComboBoxItem Content="Dimmer RGBWW 6ch" Tag="DimmerRgbww6" />
                    </ComboBox>
                    <TextBox x:Name="Hub1LightOrderTextBox" Grid.Row="1" Grid.Column="9" />

                    <CheckBox x:Name="Hub2EnabledCheckBox" Grid.Row="2" Grid.Column="0" IsChecked="True" />
                    <TextBox x:Name="Hub2NameTextBox" Grid.Row="2" Grid.Column="1" />
                    <TextBox x:Name="Hub2BridgeIpTextBox" Grid.Row="2" Grid.Column="2" />
                    <PasswordBox x:Name="Hub2ApplicationKeyBox" Grid.Row="2" Grid.Column="3" />
                    <PasswordBox x:Name="Hub2EntertainmentKeyBox" Grid.Row="2" Grid.Column="4" />
                    <TextBox x:Name="Hub2EntertainmentGroupIdTextBox" Grid.Row="2" Grid.Column="5" />
                    <TextBox x:Name="Hub2UniverseTextBox" Grid.Row="2" Grid.Column="6" />
                    <TextBox x:Name="Hub2StartChannelTextBox" Grid.Row="2" Grid.Column="7" />
                    <ComboBox x:Name="Hub2FixtureModeComboBox" Grid.Row="2" Grid.Column="8">
                        <ComboBoxItem Content="RGB 3ch" Tag="Rgb3" />
                        <ComboBoxItem Content="RGBWW 5ch" Tag="Rgbww5" />
                        <ComboBoxItem Content="Dimmer RGBWW 6ch" Tag="DimmerRgbww6" />
                    </ComboBox>
                    <TextBox x:Name="Hub2LightOrderTextBox" Grid.Row="2" Grid.Column="9" />

                    <CheckBox x:Name="Hub3EnabledCheckBox" Grid.Row="3" Grid.Column="0" IsChecked="True" />
                    <TextBox x:Name="Hub3NameTextBox" Grid.Row="3" Grid.Column="1" />
                    <TextBox x:Name="Hub3BridgeIpTextBox" Grid.Row="3" Grid.Column="2" />
                    <PasswordBox x:Name="Hub3ApplicationKeyBox" Grid.Row="3" Grid.Column="3" />
                    <PasswordBox x:Name="Hub3EntertainmentKeyBox" Grid.Row="3" Grid.Column="4" />
                    <TextBox x:Name="Hub3EntertainmentGroupIdTextBox" Grid.Row="3" Grid.Column="5" />
                    <TextBox x:Name="Hub3UniverseTextBox" Grid.Row="3" Grid.Column="6" />
                    <TextBox x:Name="Hub3StartChannelTextBox" Grid.Row="3" Grid.Column="7" />
                    <ComboBox x:Name="Hub3FixtureModeComboBox" Grid.Row="3" Grid.Column="8">
                        <ComboBoxItem Content="RGB 3ch" Tag="Rgb3" />
                        <ComboBoxItem Content="RGBWW 5ch" Tag="Rgbww5" />
                        <ComboBoxItem Content="Dimmer RGBWW 6ch" Tag="DimmerRgbww6" />
                    </ComboBox>
                    <TextBox x:Name="Hub3LightOrderTextBox" Grid.Row="3" Grid.Column="9" />

                    <CheckBox x:Name="Hub4EnabledCheckBox" Grid.Row="4" Grid.Column="0" IsChecked="True" />
                    <TextBox x:Name="Hub4NameTextBox" Grid.Row="4" Grid.Column="1" />
                    <TextBox x:Name="Hub4BridgeIpTextBox" Grid.Row="4" Grid.Column="2" />
                    <PasswordBox x:Name="Hub4ApplicationKeyBox" Grid.Row="4" Grid.Column="3" />
                    <PasswordBox x:Name="Hub4EntertainmentKeyBox" Grid.Row="4" Grid.Column="4" />
                    <TextBox x:Name="Hub4EntertainmentGroupIdTextBox" Grid.Row="4" Grid.Column="5" />
                    <TextBox x:Name="Hub4UniverseTextBox" Grid.Row="4" Grid.Column="6" />
                    <TextBox x:Name="Hub4StartChannelTextBox" Grid.Row="4" Grid.Column="7" />
                    <ComboBox x:Name="Hub4FixtureModeComboBox" Grid.Row="4" Grid.Column="8">
                        <ComboBoxItem Content="RGB 3ch" Tag="Rgb3" />
                        <ComboBoxItem Content="RGBWW 5ch" Tag="Rgbww5" />
                        <ComboBoxItem Content="Dimmer RGBWW 6ch" Tag="DimmerRgbww6" />
                    </ComboBox>
                    <TextBox x:Name="Hub4LightOrderTextBox" Grid.Row="4" Grid.Column="9" />
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="2" Text="Status" FontWeight="SemiBold" />

        <TextBox
            x:Name="StatusText"
            Grid.Row="3"
            AcceptsReturn="True"
            IsReadOnly="True"
            TextWrapping="Wrap"
            Text="No profile running." />
    </Grid>
</Window>
